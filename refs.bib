@misc{miller:2022,
	title = {Not-{Quite} {Transcendental} {Functions} and their {Applications}},
	url = {http://arxiv.org/abs/2206.08957},
	doi = {10.48550/arXiv.2206.08957},
	abstract = {Transcendental functions, such as exponentials and
                  logarithms, appear in a broad array of computational
                  domains: from simulations in curvilinear coor
                  dinates, to interpolation, to machine
                  learning. Unfortunately they are typically expensive
                  to compute accurately. In this note, we argue that
                  in many cases, the properti es of the function
                  matters more than the exact functional form. We
                  present new functions, which are not transcendental,
                  that can be used as drop-in replacements for the
                  exponential and logarithm in many settings for a
                  signiﬁcant performance boost. We show that for
                  certain applications using these functions result in
                  no drop in the accur acy at all, as they are
                  perfectly accurate representations of themselves, if
                  not the original transcendental functions.},
